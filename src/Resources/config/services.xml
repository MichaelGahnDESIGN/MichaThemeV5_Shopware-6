<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="MichaThemeV5\Twig\LicenseExtension">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="cache.object"/>
            <tag name="twig.extension"/>
        </service>
        <service id="MichaThemeV5\Update\ReleaseMetadata" abstract="true"/>
    <service id="MichaThemeV5\Update\ArchiveValidator"/>
    <service id="MichaThemeV5\Update\DownloadPolicy"/>
    <service id="MichaThemeV5\Update\GitHubClient"><argument type="service" id="MichaThemeV5\Update\DownloadPolicy"/></service>
    <service id="MichaThemeV5\Update\AtomicInstaller"><argument type="service" id="MichaThemeV5\Update\ArchiveValidator"/></service>
    <service id="MichaThemeV5\Update\GitHubReleaseUpdater">
      <argument type="service" id="MichaThemeV5\Update\GitHubClient"/><argument type="service" id="MichaThemeV5\Update\AtomicInstaller"/><argument type="service" id="Shopware\Core\Framework\Plugin\PluginService"/><argument>%kernel.project_dir%</argument>
    </service>
    <service id="MichaThemeV5\Controller\UpdateController" public="true">
      <argument type="service" id="MichaThemeV5\Update\GitHubReleaseUpdater"/><argument type="service" id="logger"/>
      <call method="setContainer"><argument type="service" id="service_container"/></call><tag name="controller.service_arguments"/>
    </service>
    <service id="MichaThemeV5\ScheduledTask\UpdateTask"><tag name="shopware.scheduled.task"/></service>
    <service id="MichaThemeV5\ScheduledTask\UpdateTaskHandler">
      <argument type="service" id="scheduled_task.repository"/><argument type="service" id="logger"/><argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/><argument type="service" id="MichaThemeV5\Update\GitHubReleaseUpdater"/>
      <tag name="messenger.message_handler" handles="MichaThemeV5\ScheduledTask\UpdateTask"/>
    </service>
    <service id="MichaThemeV5\NotificationCenter\Service\NotificationService"><argument type="service" id="Doctrine\DBAL\Connection"/></service>
    <service id="MichaThemeV5\NotificationCenter\Controller\NotificationController" public="true"><argument type="service" id="MichaThemeV5\NotificationCenter\Service\NotificationService"/><tag name="controller.service_arguments"/></service>
    <service id="MichaThemeV5\NotificationCenter\Controller\NotificationAdminController" public="true"><argument type="service" id="MichaThemeV5\NotificationCenter\Service\NotificationService"/><tag name="controller.service_arguments"/></service>
    <service id="MichaThemeV5\NotificationCenter\Subscriber\ProductSubscriber"><argument type="service" id="MichaThemeV5\NotificationCenter\Service\NotificationService"/><tag name="kernel.event_subscriber"/></service>
    <service id="MichaThemeV5\NotificationCenter\Subscriber\OrderSubscriber"><argument type="service" id="MichaThemeV5\NotificationCenter\Service\NotificationService"/><argument type="service" id="Doctrine\DBAL\Connection"/><tag name="kernel.event_subscriber"/></service>
  </services>
</container>
