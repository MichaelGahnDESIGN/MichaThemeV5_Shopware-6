<sw-page class="mgd-notification-center"><template #smart-bar-header><h2>Notification Center</h2></template><template #content><sw-card title="Neue Meldung"><sw-text-field v-model:value="title" label="Titel" required/><sw-textarea-field v-model:value="body" label="Text" required/><sw-single-select v-model:value="scope" label="Bereich" :options="[{ value: 'public', label: 'Öffentlich' }, { value: 'personal', label: 'Persönlich' }]"/><sw-text-field v-if="scope === 'personal'" v-model:value="customerId" label="Kunden-ID"/><sw-single-select v-model:value="status" label="Status" :options="[{ value: 'draft', label: 'Entwurf' }, { value: 'published', label: 'Veröffentlicht' }]"/><sw-button variant="primary" @click="save">Speichern</sw-button><p v-if="saved">Gespeichert.</p><p v-if="error">{{ error }}</p></sw-card></template></sw-page>
