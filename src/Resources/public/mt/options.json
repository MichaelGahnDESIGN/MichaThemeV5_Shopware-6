        {
            "id": "legal_unit_price",
            "group": "legal",
            "type": "toggle",
            "mode": "simple",
            "label": "Grundpreis anzeigen",
            "default": true,
            "help": "Pflicht, wo die Preisangabenverordnung einen Grundpreis verlangt.",
            "locked_by_law": true
        },
        {
            "id": "a11y_focus",
            "group": "a11y",
            "type": "select",
            "mode": "simple",
            "label": "Fokusrahmen",
