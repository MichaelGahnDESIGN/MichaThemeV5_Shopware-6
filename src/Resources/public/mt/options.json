            "help": "Nur eintragen, was im Shop tatsächlich gilt."
        },
        {
            "id": "trust_2",
            "group": "footer",
            "type": "text",
            "mode": "simple",
            "label": "Vertrauens-Hinweis 2",
            "default": "",
            "help": ""
        },
        {
            "id": "trust_3",
            "group": "footer",
            "type": "text",
            "mode": "simple",
            "label": "Vertrauens-Hinweis 3",
            "default": "",
            "help": ""
        },
