        {
            "id": "performance",
            "label": "Geschwindigkeit",
            "help": "Ladezeit"
        },
        {
            "id": "advanced",
            "label": "Erweitert",
            "help": "Eigener Code (Pro)"
        }
    ],
    "options": [
        {
            "id": "color_mode",
            "group": "colors",
            "type": "select",
            "mode": "simple",
            "label": "Farbmodus",
            "default": "system",
            "help": "Hell, Dunkel oder dem Gerät folgen. Besucher können im Shop umschalten.",
            "choices": {
                "system": "Wie das Gerät",
                "light": "Hell",
                "dark": "Dunkel"
            },
            "attr": "data-theme"
        },
        {
            "id": "accent",
            "group": "colors",
            "type": "select",
            "mode": "simple",
            "label": "Akzentfarbe",
            "default": "indigo",
            "help": "Farbe für Buttons, Links und Hervorhebungen. Alle Varianten sind für Hell und Dunkel auf Kontrast geprüft.",
            "choices": {
                "teal": "Petrol",
                "indigo": "Indigo",
                "amber": "Bernstein",
                "rose": "Rose",
                "graphite": "Graphit"
            },
            "attr": "data-accent"
        },
        {
            "id": "accent_custom",
            "group": "colors",
            "type": "color",
            "mode": "expert",
            "label": "Eigene Akzentfarbe",
            "default": "",
            "help": "Leer lassen, um die Akzentfarbe von oben zu nutzen. Achtung: Eigene Farben werden nicht automatisch auf Kontrast geprüft.",
            "css": "--mt-accent-custom"
        },
        {
            "id": "mode_toggle",
            "group": "colors",
            "type": "toggle",
            "mode": "simple",
            "label": "Umschalter Hell/Dunkel im Header anzeigen",
            "default": true,
            "help": ""
        },
        {
            "id": "font_body",
            "group": "typography",
            "type": "font",
            "mode": "simple",
            "label": "Schrift für Text",
            "default": "inter",
            "help": "Alle Schriften liegen lokal im Theme, es gibt keinen Abruf bei Google.",
            "attr": "data-mt-font-body"
        },
        {
            "id": "font_heading",
            "group": "typography",
            "type": "font",
            "mode": "simple",
            "label": "Schrift für Überschriften",
            "default": "inter",
            "help": "",
            "attr": "data-mt-font-heading"
        },
        {
            "id": "font_size",
            "group": "typography",
            "type": "select",
            "mode": "simple",
            "label": "Schriftgröße",
            "default": "normal",
            "help": "",
            "choices": {
                "small": "Klein",
                "normal": "Normal",
                "large": "Groß"
            },
            "attr": "data-mt-size"
        },
        {
            "id": "radius",
            "group": "shape",
            "type": "select",
            "mode": "simple",
            "label": "Ecken",
            "default": "soft",
            "help": "Rundung von Karten, Buttons und Bildern.",
            "choices": {
                "sharp": "Eckig",
                "soft": "Leicht gerundet",
                "round": "Stark gerundet"
            },
            "attr": "data-mt-radius"
        },
        {
            "id": "density",
            "group": "shape",
            "type": "select",
            "mode": "simple",
            "label": "Abstände",
            "default": "normal",
            "help": "",
            "choices": {
                "compact": "Kompakt",
                "normal": "Normal",
                "airy": "Luftig"
            },
            "attr": "data-mt-density"
        },
        {
            "id": "shadows",
            "group": "shape",
            "type": "select",
            "mode": "expert",
            "label": "Schatten",
            "default": "soft",
            "help": "",
            "choices": {
                "none": "Keine",
                "soft": "Weich",
                "strong": "Kräftig"
            },
            "attr": "data-mt-shadow"
        },
        {
            "id": "buttons",
            "group": "shape",
            "type": "select",
            "mode": "expert",
            "label": "Button-Stil",
            "default": "solid",
            "help": "",
            "choices": {
                "solid": "Gefüllt",
                "outline": "Umrandet",
                "pill": "Pillenform"
            },
            "attr": "data-mt-buttons"
        },
        {
            "id": "logo_light",
            "group": "logo",
            "type": "media",
            "mode": "simple",
            "label": "Logo (heller Hintergrund)",
            "default": "",
            "help": "SVG oder PNG, mindestens doppelte Größe für scharfe Darstellung."
        },
        {
            "id": "logo_dark",
            "group": "logo",
            "type": "media",
            "mode": "simple",
            "label": "Logo (dunkler Hintergrund)",
            "default": "",
            "help": "Optional. Ohne Angabe wird das helle Logo genutzt."
        },
        {
            "id": "logo_alt",
            "group": "logo",
            "type": "text",
            "mode": "simple",
            "label": "Alternativtext des Logos",
            "default": "",
            "help": "Wird von Screenreadern vorgelesen. Meist der Shopname."
        },
        {
            "id": "logo_height",
            "group": "logo",
            "type": "range",
            "mode": "simple",
            "label": "Logohöhe in Pixel",
            "default": 40,
            "help": "",
            "min": 24,
            "max": 96,
            "step": 2,
            "css": "--mt-logo-height",
            "unit": "px"
        },
        {
            "id": "favicon",
            "group": "logo",
            "type": "media",
            "mode": "expert",
            "label": "Favicon",
            "default": "",
            "help": ""
        },
        {
            "id": "header_layout",
            "group": "header",
            "type": "select",
            "mode": "simple",
            "label": "Header-Layout",
            "default": "classic",
            "help": "Aufbau des Kopfbereichs.",
            "choices": {
                "classic": "Klassisch (Logo links)",
                "centered": "Zentriert (Logo mittig)",
                "compact": "Kompakt (eine Zeile)"
            },
            "attr": "data-mt-header"
        },
        {
            "id": "header_sticky",
            "group": "header",
            "type": "toggle",
            "mode": "simple",
            "label": "Header beim Scrollen fixieren",
            "default": true,
            "help": "",
            "attr": "data-mt-sticky"
        },
        {
            "id": "header_search",
            "group": "header",
            "type": "select",
            "mode": "simple",
            "label": "Suche",
            "default": "field",
            "help": "",
            "choices": {
                "icon": "Nur Symbol",
                "field": "Suchfeld",
                "expanded": "Großes Suchfeld"
            },
            "attr": "data-mt-search"
        },
        {
            "id": "announcement",
            "group": "header",
            "type": "toggle",
            "mode": "simple",
            "label": "Ankündigungsleiste anzeigen",
