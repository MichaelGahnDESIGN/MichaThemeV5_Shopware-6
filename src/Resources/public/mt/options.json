{
    "version": 1,
    "groups": [
        {
            "id": "colors",
            "label": "Farben",
            "help": "Akzentfarbe, Modus und eigene Farben"
        },
        {
            "id": "colors_custom",
            "label": "Eigene Farben",
            "help": "Farben für Hell und Dunkel einzeln einstellen. Leer = Standard des Themes. Mit Colorpicker, eigener Farbpalette und Kontrast-Warnung. Gespeichert wird immer, auch bei Warnung."
        },
        {
            "id": "typography",
            "label": "Schriften",
            "help": "Lokale Schriften und Größen"
        },
        {
            "id": "shape",
            "label": "Form und Stil",
            "help": "Ecken, Abstände, Schatten, Buttons"
        },
        {
            "id": "logo",
            "label": "Logo",
            "help": "Logo, Favicon, Größe"
        },
        {
            "id": "header",
            "label": "Header",
            "help": "Kopfbereich und Suche"
        },
        {
            "id": "footer",
            "label": "Footer",
            "help": "Fußbereich"
        },
        {
            "id": "hero",
            "label": "Startseite",
            "help": "Hero-Bereich"
        },
        {
            "id": "listing",
            "label": "Kategorie und Listing",
            "help": "Produktlisten"
        },
        {
            "id": "detail",
            "label": "Artikelseite",
            "help": "Produkt-Detailseite"
        },
        {
            "id": "legal",
            "label": "Recht",
            "help": "Preisangaben und Pflichttexte"
        },
        {
            "id": "a11y",
            "label": "Barrierefreiheit",
            "help": "Fokus, Textgröße, Bewegung"
        },
        {
            "id": "performance",
            "label": "Geschwindigkeit",
            "help": "Ladezeit"
        },
        {
            "id": "license",
            "label": "Lizenz",
            "help": "Optionaler Lizenzschlüssel für separat erhältliche Erweiterungen. Ohne Schlüssel läuft das Theme mit allen Funktionen dieser Version. Verwaltung unter https://theme.michael-gahn.de (Konto erforderlich)."
        }
    ],
    "options": [
        {
            "id": "color_mode",
            "group": "colors",
            "type": "select",
            "mode": "simple",
            "label": "Farbmodus",
            "default": "system",
            "help": "Hell, Dunkel oder dem Gerät folgen. Besucher können im Shop umschalten.",
            "choices": {
                "system": "Wie das Gerät",
                "light": "Hell",
                "dark": "Dunkel"
            },
            "attr": "data-theme"
        },
        {
            "id": "accent",
            "group": "colors",
            "type": "select",
            "mode": "simple",
            "label": "Akzentfarbe",
            "default": "red",
            "help": "Farbe für Buttons, Links und Hervorhebungen. Alle Varianten sind für Hell und Dunkel auf Kontrast geprüft.",
            "choices": {
                "red": "Rot",
                "teal": "Petrol",
                "indigo": "Indigo",
                "amber": "Bernstein",
                "rose": "Rose",
                "graphite": "Graphit"
            },
            "attr": "data-accent"
        },
        {
            "id": "accent_custom",
            "group": "colors",
            "type": "color",
            "mode": "expert",
            "label": "Eigene Akzentfarbe",
            "default": "",
            "help": "Leer lassen, um die Akzentfarbe von oben zu nutzen. Achtung: Eigene Farben werden nicht automatisch auf Kontrast geprüft.",
            "css": "--mt-accent-custom"
        },
        {
            "id": "mode_toggle",
            "group": "colors",
            "type": "toggle",
            "mode": "simple",
            "label": "Umschalter Hell/Dunkel anzeigen",
            "default": true,
            "help": "Aus = es gibt keinen Umschalter im Shop. Wo er steht, wählen Sie darunter."
