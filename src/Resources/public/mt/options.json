        {
            "id": "announcement_text",
            "group": "header",
            "type": "text",
            "mode": "simple",
            "label": "Text der Ankündigungsleiste",
            "default": "Kostenloser Versand ab 50 €",
            "help": "Bitte nur belegbare Aussagen verwenden (UWG)."
