        {
            "id": "footer_layout",
            "group": "footer",
            "type": "select",
            "mode": "simple",
            "label": "Footer-Layout",
            "default": "columns",
            "help": "",
            "choices": {
                "columns": "Mehrspaltig",
                "centered": "Zentriert",
                "minimal": "Minimal"
            },
            "attr": "data-mt-footer"
