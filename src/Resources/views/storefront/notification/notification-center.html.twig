{# Glocke - placement: menu (Header) oder footer. Aus, wenn der Schalter in den Plugin-Einstellungen aus ist. Bleibt hidden, bis der Feed mind. 1 Eintrag liefert (mt-notification-center.js) #}
{% set mtNcPlace = placement|default('menu') %}
{# Icons lokal im Plugin, Auswahl in den Plugin-Einstellungen #}
{% set mtNcIcons = {
    'bell': '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
    'bell-ring': '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/><path d="M22 8c0-2.3-.8-4.3-2-6"/>',
    'bell-dot': '<path d="M19.4 14.9C20.2 16.4 21 17 21 17H3s3-2 3-9c0-3.3 2.7-6 6-6 .7 0 1.3.1 1.9.3"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><circle cx="18" cy="8" r="3"/>',
    'megaphone': '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
    'inbox': '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
    'mail': '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
    'message': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
    'info': '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
    'star': '<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
    'sparkles': '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>'
} %}
{% set mtNcIcon = config('MichaThemeV5.config.notificationIcon')|default('bell') %}
{% if mtNcIcons[mtNcIcon] is not defined %}{% set mtNcIcon = 'bell' %}{% endif %}
{% if config('MichaThemeV5.config.notificationCenterEnabled') is not same as(false) %}
    <div class="mt-notification-center mt-notification-center--{{ mtNcPlace }}" data-mt-notification-center hidden data-feed-url="{{ path('frontend.mgd.notification.feed') }}" data-read-url="{{ path('frontend.mgd.notification.read', { id: '00000000000000000000000000000000' }) }}" data-dismiss-url="{{ path('frontend.mgd.notification.dismiss', { id: '00000000000000000000000000000000' }) }}" data-read-all-url="{{ path('frontend.mgd.notification.read_all') }}" data-dismiss-read-url="{{ path('frontend.mgd.notification.dismiss_read') }}" data-logged-in="{{ context.customer ? '1' : '0' }}">
        <button type="button" class="mt-notification-button" aria-expanded="false" aria-controls="mt-notification-panel-{{ mtNcPlace }}" aria-label="Benachrichtigungen"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ mtNcIcons[mtNcIcon]|raw }}</svg><span class="mt-notification-count mt-list-count" aria-hidden="true" hidden>0</span></button>
        <section id="mt-notification-panel-{{ mtNcPlace }}" class="mt-notification-panel" aria-label="Benachrichtigungen" hidden>
            <div class="mt-notification-head">
                <strong>Benachrichtigungen</strong>
                <span class="mt-notification-tools">
                    <button type="button" class="mt-notification-tool mt-notification-read-all" disabled>Alle gelesen</button>
                    <button type="button" class="mt-notification-tool mt-notification-hide-read" disabled>Gelesene ausblenden</button>
                </span>
            </div>
            <p class="mt-notification-status" role="status" aria-live="polite"></p>
            <p class="mt-notification-empty">Keine neuen Benachrichtigungen.</p>
            <ul class="mt-notification-list"></ul>
            <button type="button" class="mt-notification-show-all" aria-haspopup="dialog" hidden>Alle anzeigen</button>
        </section>
    </div>
{% endif %}
