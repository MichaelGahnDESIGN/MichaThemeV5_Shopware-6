{# Glocke - placement: menu (Header) oder footer. Aus, wenn der Schalter in den Plugin-Einstellungen aus ist. #}
{% set mtNcPlace = placement|default('menu') %}
{% if config('MichaThemeV5.config.notificationCenterEnabled') is not same as(false) %}
    <div class="mt-notification-center mt-notification-center--{{ mtNcPlace }}" data-mt-notification-center data-feed-url="{{ path('frontend.mgd.notification.feed') }}" data-read-url="{{ path('frontend.mgd.notification.read', { id: '00000000000000000000000000000000' }) }}">
        <button type="button" class="mt-notification-button" aria-expanded="false" aria-controls="mt-notification-panel-{{ mtNcPlace }}" aria-label="Benachrichtigungen"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><span class="mt-notification-count" hidden>0</span></button>
        <section id="mt-notification-panel-{{ mtNcPlace }}" class="mt-notification-panel" aria-label="Benachrichtigungen" hidden>
            <p class="mt-notification-empty">Keine neuen Benachrichtigungen.</p>
            <ul class="mt-notification-list"></ul>
        </section>
    </div>
{% endif %}
