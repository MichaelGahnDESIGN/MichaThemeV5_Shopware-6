{# Herz Favoriten - mtFavId, mtFavName, mtFavUrl, mtFavClass (card | detail), Liste nur im Browser > mt-theme.js #}
<button type="button" class="mt-fav-toggle mt-fav-toggle--{{ mtFavClass|default('card') }}" data-mt-fav-toggle data-mt-fav-id="{{ mtFavId }}" data-mt-fav-title="{{ mtFavName }}" data-mt-fav-url="{{ mtFavUrl }}" aria-pressed="false" aria-label="Zu Favoriten hinzufügen: {{ mtFavName }}" title="Zu Favoriten hinzufügen: {{ mtFavName }}" data-label-add="Zu Favoriten hinzufügen: %s" data-label-remove="Aus Favoriten entfernen: %s"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>
