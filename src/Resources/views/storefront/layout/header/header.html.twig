{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{# Modus-Schalter + Glocke bei den Aktionen (Konto, Warenkorb). layout_header_top_bar liegt in top-bar.html.twig und wurde hier nie gerendert, daher dieser Block #}
{% block layout_header_actions_account %}
    {% if theme_config('mt-mode-toggle') %}
        <div class="col-auto">
            <button type="button" class="btn header-actions-btn mt-mode-toggle" data-mt-mode-toggle aria-label="Farbmodus wechseln" title="Farbmodus wechseln">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
                <span class="mt-mode-label" data-mt-mode-label>Wie das Gerät</span>
            </button>
        </div>
    {% endif %}
    {% if config('MichaThemeV5.config.notificationCenterEnabled') is not same as(false) %}
        <div class="col-auto">
            {% sw_include '@MichaThemeV5/storefront/notification/notification-center.html.twig' with { placement: 'menu' } %}
        </div>
    {% endif %}
    {{ parent() }}
{% endblock %}
