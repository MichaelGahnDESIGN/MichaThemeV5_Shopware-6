{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{# Icon-Leiste: Schalter, Glocke, Merkliste (nativ), Favoriten, Konto, Warenkorb - Schalter + Glocke hinter Such-Toggle, der liegt direkt vor der Wunchsliste #}
{% block layout_header_search_toggle %}
    {{ parent() }}
    {% set mtPlace = theme_config('mt-mode-toggle-place')|default('header') %}
    {% if theme_config('mt-mode-toggle') and mtPlace == 'header' %}
        <div class="col-auto">
            {# Schalter nur Icon - Zustand in aria-label/title aus mt-theme.js #}
            <button type="button" class="btn header-actions-btn mt-mode-toggle mt-mode-toggle--icon" data-mt-mode-toggle data-mt-place="header" aria-label="Farbmodus: Wie das Gerät. Zum Wechseln klicken." title="Farbmodus: Wie das Gerät. Zum Wechseln klicken.">
                {% sw_include '@MichaThemeV5/storefront/component/mt-mode-icons.html.twig' %}
            </button>
        </div>
    {% endif %}
    {% if config('MichaThemeV5.config.notificationCenterEnabled') is not same as(false) %}
        <div class="col-auto">
            {% sw_include '@MichaThemeV5/storefront/notification/notification-center.html.twig' with { placement: 'menu' } %}
        </div>
    {% endif %}
{% endblock %}

{# Favoriten Herz-Liste vor Konto #}
{% block layout_header_actions_account %}
    {% if theme_config('mt-favorites') %}
        <div class="col-auto">
            <div class="mt-hdr-item mt-hdr-item--favs" data-mt-fav-item hidden>
                <button type="button" class="btn header-actions-btn mt-fav-open" data-mt-fav-open aria-expanded="false" aria-controls="mt-fav-panel" data-label-count="Favoriten, %s Einträge" data-label-count-one="Favoriten, %s Eintrag" aria-label="Favoriten" title="Favoriten">
                    <svg class="mt-hdr-ico" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                    <span class="mt-list-count" data-mt-fav-count aria-hidden="true">0</span>
                </button>
                <section id="mt-fav-panel" class="mt-fav-panel" data-mt-fav-panel data-label-remove="Aus Favoriten entfernen: %s" aria-label="Favoriten" hidden><ul class="mt-fav-list" data-mt-fav-list></ul></section>
            </div>
        </div>
    {% endif %}
    {{ parent() }}
{% endblock %}
