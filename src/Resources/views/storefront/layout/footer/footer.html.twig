{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{# Trust Bereich - Block layout_footer gibt es in 6.6/6.7 nicht, layout_footer_inner_container schon #}
{% block layout_footer_inner_container %}
    {% if theme_config('mt-footer-trust') %}
        {% set mtTrust = [theme_config('mt-trust-1'), theme_config('mt-trust-2'), theme_config('mt-trust-3')]|filter(t => t) %}
        {% if mtTrust|length > 0 %}
            <section class="container mt-section" aria-label="Unsere Versprechen">
                <ul class="mt-trust">
                    {% for t in mtTrust %}<li>{{ t }}</li>{% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{# Links Pflichtseiten: Widerruf (eigene Seite, ab 6.7.9 gibt es auch den Shopware Button) + Barrierefreiheit #}
{% block layout_footer_bottom %}
    {% set mtLinks = [] %}
    {% set mtWd = theme_config('mt-legal-withdrawal-page')|trim %}
    {% if mtWd and ((mtWd starts with '/' and not (mtWd starts with '//')) or mtWd starts with 'https://' or mtWd starts with 'http://') %}
        {% set mtLinks = mtLinks|merge([{ label: 'Vertrag widerrufen', url: mtWd, cls: 'mt-withdraw-link' }]) %}
    {% endif %}
    {% set mtA11y = theme_config('mt-a11y-statement-page')|trim %}
    {% if mtA11y and ((mtA11y starts with '/' and not (mtA11y starts with '//')) or mtA11y starts with 'https://' or mtA11y starts with 'http://') %}
        {% set mtLinks = mtLinks|merge([{ label: 'Erklärung zur Barrierefreiheit', url: mtA11y, cls: '' }]) %}
    {% endif %}
    {% if mtLinks|length > 0 %}
        <nav class="container mt-legal-links" aria-label="Pflichtlinks">
            <ul class="list-unstyled d-flex flex-wrap gap-3">
                {% for l in mtLinks %}<li><a{% if l.cls %} class="{{ l.cls }}"{% endif %} href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}
            </ul>
        </nav>
    {% endif %}
    {{ parent() }}
    {# Hell/Dunkel Schalter Footer #}
    {% if theme_config('mt-mode-toggle') and theme_config('mt-mode-toggle-place') == 'footer' %}
        <div class="container mt-footer-mode">
            <button type="button" class="mt-mode-toggle" data-mt-mode-toggle data-mt-place="footer" aria-label="Farbmodus: Wie das Gerät. Zum Wechseln klicken." title="Farbmodus: Wie das Gerät. Zum Wechseln klicken.">
                {% sw_include '@MichaThemeV5/storefront/component/mt-mode-icons.html.twig' %}
                <span class="mt-mode-text">Farbmodus: <span data-mt-mode-label>Wie das Gerät</span></span>
            </button>
        </div>
    {% endif %}
    {# Glocke Footer - im Block layout_footer_bottom, einen Block layout_footer gibt es in Shopware 6.7 nicht #}
    {% sw_include '@MichaThemeV5/storefront/notification/notification-center.html.twig' with { placement: 'footer' } %}
{% endblock %}
