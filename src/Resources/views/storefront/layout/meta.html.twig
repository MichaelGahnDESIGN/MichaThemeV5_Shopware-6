{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}

{% block layout_head_stylesheet %}
    {% sw_include '@MichaThemeV5/storefront/layout/mt-config.html.twig' %}
    <script src="{{ asset('bundles/michathemev5/mt/mt-init.js') }}"></script>
    {% if theme_config('mt-perf-preload-fonts') %}
        <link rel="preload" href="{{ asset('bundles/michathemev5/mt/fonts/inter-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    {% endif %}
    <link rel="stylesheet" href="{{ asset('bundles/michathemev5/mt/mt-fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/michathemev5/mt/mt-tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/michathemev5/mt/mt-base.css') }}">
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/michathemev5/mt/mt-shopware.css') }}">
    <script src="{{ asset('bundles/michathemev5/mt/mt-theme.js') }}" defer></script>
    {# Eigenes CSS/JS: nur mit Pro-Modul "custom-code" (Lizenzprüfung). CSS ohne Tags, JS nur von Administratoren erfasst. #}
    {% if mt_pro('custom-code', theme_config('mt-license-token')) %}
        {% if theme_config('mt-custom-css') %}<style id="mt-custom-css">{{ theme_config('mt-custom-css')|striptags|raw }}</style>{% endif %}
        {% if theme_config('mt-custom-js') %}<script id="mt-custom-js">{{ theme_config('mt-custom-js')|raw }}</script>{% endif %}
    {% endif %}
{% endblock %}
