{# AUTOMATISCH ERZEUGT aus themes/core/options.json (php bin/build-themes.php). Nicht von Hand ändern. #}
{% set mtMods = {} %}
{% if mt_pro('popup', theme_config('mt-license-token')) %}{% set mtMods = mtMods|merge({ 'popup': { 'popup_title': theme_config('mt-popup-title'), 'popup_text': theme_config('mt-popup-text'), 'popup_cta_label': theme_config('mt-popup-cta-label'), 'popup_cta_url': theme_config('mt-popup-cta-url'), 'popup_trigger': theme_config('mt-popup-trigger'), 'popup_delay': theme_config('mt-popup-delay'), 'popup_frequency': theme_config('mt-popup-frequency'), 'popup_home_only': theme_config('mt-popup-home-only') } }) %}{% endif %}
{% if mt_pro('versand-progress', theme_config('mt-license-token')) %}{% set mtMods = mtMods|merge({ 'versand-progress': { 'ship_threshold': theme_config('mt-ship-threshold'), 'ship_text': theme_config('mt-ship-text'), 'ship_done_text': theme_config('mt-ship-done-text') } }) %}{% endif %}
{% if mt_pro('stock-progress', theme_config('mt-license-token')) %}{% set mtMods = mtMods|merge({ 'stock-progress': { 'stock_threshold': theme_config('mt-stock-threshold'), 'stock_text': theme_config('mt-stock-text') } }) %}{% endif %}
{% if mt_pro('rabatt', theme_config('mt-license-token')) %}{% set mtMods = mtMods|merge({ 'rabatt': { 'discount_percent': theme_config('mt-discount-percent'), 'discount_countdown': theme_config('mt-discount-countdown'), 'discount_lowest_label': theme_config('mt-discount-lowest-label') } }) %}{% endif %}
{% if mtMods %}<meta name="mt-modules" content="{{ mtMods|json_encode|escape('html_attr') }}">{% endif %}
